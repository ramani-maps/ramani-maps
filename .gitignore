# Generated by build-maplibre-ios.sh (MapLibre framework resource bundle).
# Keep the directory tracked via .gitkeep, ignore the build artifacts.
ramani-maplibre/src/iosMain/composeResources/files/*
!ramani-maplibre/src/iosMain/composeResources/files/.gitkeep

**/*.xcuserstate
**/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/project.pbxproj

# The iOS example Xcode project is generated by XcodeGen from
# example/iosApp/project.yml — run `xcodegen generate` in example/iosApp.
# Keeping it untracked avoids pbxproj churn and prevents leaking DEVELOPMENT_TEAM.
example/iosApp/iosApp.xcodeproj/
